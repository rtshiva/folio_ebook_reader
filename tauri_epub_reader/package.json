{
  "name": "folio-reader",
  "version": "1.0.0",
  "description": "A beautifully crafted, offline-first EPUB reader for Windows, built with Tauri, Rust, WebView2 and epub.js",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "npm run test:rust && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:rust": "cd src-tauri && cargo test"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tauri-apps/api": "^2.0.0",
    "kitten-tts-js": "^0.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-html": "^8.2.1",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0"
  }
}
